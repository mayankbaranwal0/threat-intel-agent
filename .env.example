# -- LLM providers ------------------------------------------------------------
# At least one provider key is needed for live agent runs.
# The app runs fully offline (fixtures) with ZERO keys - see README quickstart.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Router and synthesis models are independently configurable (Pydantic AI model strings).
# Cost-optimized router option: anthropic:claude-haiku-4-5
# Gemini alternative (both roles):  google:gemini-3.6-flash
ROUTER_MODEL=anthropic:claude-sonnet-5
AGENT_MODEL=anthropic:claude-sonnet-5

# -- Threat-intel sources (all optional - fixtures cover zero-key mode) -------
# VirusTotal:  https://www.virustotal.com/gui/join-us         (free tier: 4 req/min)
# AbuseIPDB:   https://www.abuseipdb.com/register             (free tier: 1k req/day)
# AlienVault OTX: https://otx.alienvault.com                  (free)
# NVD (optional, raises rate limit): https://nvd.nist.gov/developers/request-an-api-key
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
NVD_API_KEY=

# -- Data resolver ------------------------------------------------------------
# prefer_cache : serve warmed cache first, live on miss   (recording/demo mode)
# prefer_live  : fresh cache within TTL, else live        (production default)
# offline      : cache then fixtures only, never network  (zero-key evaluation)
RESOLVER_MODE=prefer_cache
